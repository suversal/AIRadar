DATABASE_URL=postgresql+psycopg://radar:radar@postgres:5432/radar
FASTEMBED_CACHE_DIR=data/model_cache/fastembed
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=
# qwen|deepseek|kimi|openai|fake；留空则按已配置的 key 自动选（ALI 优先）
AI_PROVIDER=
# 阿里云百炼（当前在用）。ALI_BASE_URL 建议填业务空间专属域名
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ALI_API_KEY=
ALI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
QWEN_MAX_TOKENS=4096
# 只作用于打分调用的思考 token 上限。实测 0/50/100/200 四档里 50 分类一致率
# 最高且零失败；设 0 则完全关闭思考。详见 docs/2026-08-13-ai-cost-optimization.md
QWEN_THINKING_BUDGET=50
KIMI_API_KEY=
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k2.7-code
KIMI_BASE_URL=https://api.moonshot.cn/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_USER_ID=suversal-ai-radar
DEEPSEEK_MAX_TOKENS=2048
# off|low|high|max。DeepSeek 默认 high 且思考 token 按输出价计费，故降到 low
DEEPSEEK_SCORING_REASONING_EFFORT=low
GITHUB_TOKEN=
DEFAULT_SCORING_MODEL=gpt-4.1-mini
DEFAULT_SUMMARY_MODEL=gpt-4.1-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
JWT_SECRET=change-me
AI_PIPELINE_CONCURRENCY=1
CLUSTER_SIMILARITY_THRESHOLD=0.85
CLUSTER_WINDOW_HOURS=72
ADMIN_TOKEN=change-me-admin-token
ADMIN_MANUAL_ARTICLE_ENABLED=false
ADMIN_MANUAL_ARTICLE_PUBLISH_ENABLED=false
ADMIN_MANUAL_IMAGE_UPLOAD_ENABLED=false
MANUAL_ARTICLE_REPORTS_ENABLED=false
MANUAL_ARTICLE_MAX_RESPONSE_BYTES=8000000
IMAGE_HOST_BASE_URL=https://img.suversal.com/upload
IMAGE_HOST_AUTH_CODE=
IMAGE_HOST_UPLOAD_CHANNEL=telegram
IMAGE_HOST_CHANNEL_NAME=Tel_Channel
IMAGE_HOST_SERVER_COMPRESS=true
IMAGE_HOST_AUTO_RETRY=true
IMAGE_HOST_NAME_TYPE=short
IMAGE_HOST_RETURN_FORMAT=full
IMAGE_HOST_UPLOAD_FOLDER=
# 不要高过 apps/web/app/api/image-proxy/route.ts 的 MAX_IMAGE_BYTES(8MB)：
# 超出部分传得进来但代理取不回来，前台展示不了。写高了会被夹到 8MB 并记 warning。
IMAGE_UPLOAD_MAX_BYTES=8388608

# SourcePilot 聚合上游(公众号等 sourcepilot 类型信源)
SOURCEPILOT_BASE_URL=http://127.0.0.1:8420
