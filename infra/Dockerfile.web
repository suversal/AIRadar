FROM node:22-alpine AS builder

ARG NPM_REGISTRY=https://registry.npmmirror.com

WORKDIR /app

COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --registry=$NPM_REGISTRY

COPY apps/web ./

# 埋点站点 ID 必须在 build 之前进环境：NEXT_PUBLIC_* 是被 `next build`
# 内联进产物的，构建后再设这个变量对已生成的页面毫无作用。
# 留空则 analytics-script.tsx 整体不渲染，构建照常通过。
ARG NEXT_PUBLIC_UMAMI_WEBSITE_ID=
ENV NEXT_PUBLIC_UMAMI_WEBSITE_ID=$NEXT_PUBLIC_UMAMI_WEBSITE_ID

RUN npm run build

FROM node:22-alpine AS runner

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

WORKDIR /app

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
# standalone 产物**不含 public/**，必须单独复制（Next 官方部署文档如此要求）。
# 漏掉这一行的后果是静默的：页面照常渲染，只有 public 下的静态文件 404。
# 一直漏到 2026-08-20 才发现——在那之前 /brand/*.svg 线上全是 404，
# 而站内 logo 走的是 brand-logo.tsx 的内联 SVG，视觉上完全看不出来。
# Agent 接入的 Skill 包（/ai-radar-skill/）是第一个真正依赖它的功能。
COPY --from=builder /app/public ./public

EXPOSE 3000

CMD ["node", "server.js"]
